# ============================================================
# NEON.IMG // ENVIRONMENT CONFIGURATION
# 复制此文件为 .env 并修改敏感项
# cp .env.example .env
# ============================================================

# ---------- 基础配置 ----------
PORT=3000
JWT_SECRET=change_me_to_a_random_string_32_chars_min
ADMIN_USERNAME=admin

# ---------- 上传限制 ----------
# 单文件最大字节数（20MB = 20971520）
MAX_FILE_SIZE=20971520
# 单次上传队列总上限字节数（预留字段，当前版本未强制校验）
MAX_BATCH_SIZE=104857600

# ---------- 游客模式 ----------
# 是否开放游客匿名上传通道（true / false）
GUEST_ENABLED=true
# 每 IP 每日最大上传次数
GUEST_DAILY_LIMIT=20
# 游客单文件上限字节数（10MB）
GUEST_MAX_FILE_SIZE=10485760
# 游客图片保留天数，过期后懒清理
GUEST_RETENTION_DAYS=30
# 游客单次最大上传张数
GUEST_MAX_BATCH=3

# ---------- 图片审核 ----------
# 审核总开关（true / false），false 时跳过所有审核直接 PASS
MODERATION_ENABLED=true
# 审核服务提供方：local（仅本地预检）/ mock（测试用随机分数）
MODERATION_PROVIDER=local
# AI 评分 ≥ 此值时自动拒绝（区间 0.0 ~ 1.0）
MODERATION_THRESHOLD_REJECT=0.9
# AI 评分 ≥ 此值且 < REJECT 阈值时进入人工复审（区间 0.0 ~ 1.0）
MODERATION_THRESHOLD_REVIEW=0.6
# 审核操作日志保留天数
MODERATION_LOG_RETENTION_DAYS=180

# ---------- 限流 ----------
# 限流时间窗口（毫秒）
RATE_LIMIT_WINDOW_MS=60000
# 窗口内最大请求数（基于 IP）
RATE_LIMIT_MAX=30
